# Copy this file to .env and fill in your values

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/workforce_shift_planner

# Secret used to sign JWT tokens (any long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Port the backend server runs on
# (5001 because macOS AirPlay Receiver occupies port 5000)
PORT=5001

# AI explanations: if OLLAMA_HOST is set, tries a local Ollama model first,
# falls back to Claude if ANTHROPIC_API_KEY is set, then falls back to a plain
# template. Leave both blank to always use the template (e.g. in tests).
# Requires Ollama running locally with the model pulled, e.g. `ollama pull gemma2:2b`.
OLLAMA_HOST=
OLLAMA_MODEL=gemma2:2b

# Optional: secondary fallback for AI explanations if Ollama is unreachable.
ANTHROPIC_API_KEY=

# Optional: real payment gateways. If a gateway's keys are missing, that payment
# method runs in DEMO MODE (fake order, instant success) so demos always work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal sandbox is the default; switch to https://api-m.paypal.com for live
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
